NEXT_PUBLIC_SUPABASE_URL=https://jcfhoqrandavrajdamun.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key still works if publishable is unset
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Required to ingest chain deposits.
SETTLEMENT_INGEST_SECRET=

# Optional. Defaults to public Base Sepolia / Polygon Amoy RPCs.
CHAIN_RPC_URL_BASE=
CHAIN_RPC_URL_POLYGON=