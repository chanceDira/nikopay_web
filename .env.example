# Dashboard: https://supabase.com/dashboard/project/jcfhoqrandavrajdamun

NEXT_PUBLIC_SUPABASE_URL=https://jcfhoqrandavrajdamun.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local: http://localhost:3000. Prod: https://nikopay.rw
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WalletConnect / Reown Cloud project id (client)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

SETTLEMENT_INGEST_SECRET=

# optional admin session secret
ADMIN_SESSION_SECRET=

# rpc urls 
CHAIN_RPC_URL_BASE=
CHAIN_RPC_URL_POLYGON=

# momo sandbox (current payout rail until cutover)
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CURRENCY=EUR
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_CALLBACK_URL=
# Sandbox: leave unset (we poll). Production: https://nikopay.rw/api/momo/callback
# Success payee: 56733123453. Failed: 46733123450
MOMO_SANDBOX_PAYEE_MSISDN=56733123453

# pawapay (target rail). token from dashboard; never commit the value
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_API_TOKEN=
PAWAPAY_CALLBACK_PATH=/api/pawapay/callback
# production callback: https://nikopay.rw/api/pawapay/callback
PAWAPAY_VERIFY_CALLBACKS=false
# keep momo until orchestrator cutover
PAYOUT_PROVIDER=momo

# payout email smtp config
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=NikoPay <your@gmail.com>
# EMAIL_SITE_URL=https://nikopay.rw
